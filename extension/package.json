    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@wxt-dev/module-react": "^1.2.2",
    "typescript": "^5.9.3",
    "vite": "^8.3.0",
    "vitest": "^3.2.4",
    "wxt": "^0.21.4"
  }
}
