# ---- GitHub ----
# Public access works without a token, but rate limits are much lower.
# Fine-grained token with "Public repositories" read access is enough.
# Usually unnecessary: `npm run cli -- login:github` (or the extension's
# "扫码登录 GitHub" button) runs the device flow and writes the token here.
# Set this only to share one token across machines; it takes priority.
GITHUB_TOKEN=ghp_xxx

# ---- LLM (default: Zhipu GLM, OpenAI-compatible) ----
LLM_PROVIDER=zhipu
LLM_API_KEY=
LLM_MODEL=glm-4-flash
LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4

# ---- Feishu / Lark ----
# Usually unnecessary: `npm run cli -- login` registers a personal app by QR
# scan and stores its credentials in ~/.feishu-cli/config.yaml. Set these only
# to share one app across machines; they take priority over that file.
FEISHU_APP_ID=
FEISHU_APP_SECRET=
# Wiki space to write into. Leave empty to resolve by name, which reuses an
# existing same-named space and never creates one unless --create-space is given.
# Prefer the id: it is what the extension saves when you pick a space in its UI,
# and it is the only unambiguous handle when several spaces share a name.
FEISHU_SPACE_ID=
# Optional: path to feishu-cli binary if not on PATH
FEISHU_CLI_PATH=feishu-cli

# ---- Local API (used by the browser extension, `npm run api`) ----
# Shared bearer token the extension must send. Required: without it the service
# refuses every request instead of allowing them.
API_TOKEN=
# API_PORT=8787
# API_HOST=127.0.0.1
# 服务启动后自动注册每日同步；服务停止后不执行，不补跑停机期间的任务。
# SYNC_SCHEDULE_ENABLED=true
# SYNC_CRON=0 9 * * *
# SYNC_TIMEZONE=Asia/Shanghai

# ---- Subscriptions (used by `npm run cli -- run`) ----
# Path to the subscription file. Defaults to star-subscriptions.yaml.
# STAR_SUBSCRIPTIONS_FILE=star-subscriptions.yaml
#
# The whole YAML document inlined as one string. Takes precedence over the file
# above, and is what GitHub Actions uses so the webhook never enters the repo.
# Quoting is optional; escaped \n is turned back into real newlines, so a
# single-line secret like this works as-is.
# STAR_SUBSCRIPTIONS=space: GitHub Star 精选\nwebhook: https://open.feishu.cn/open-apis/bot/v2/hook/xxx\nauthors:\n  - login: karpathy\n    alias: Andrej Karpathy
